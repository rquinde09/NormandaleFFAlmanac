# Copy to .env.local and fill in. Never commit .env.local.
# No quotes, no spaces around "=".

# The number after leagueId= in the ESPN league URL
ESPN_LEAGUE_ID=

# Cookie values from Chrome DevTools > Application > Cookies > https://fantasy.espn.com
# espn_s2: copy as shown, with "Show URL-decoded" unchecked (it contains %2B, %2F and the like)
ESPN_S2=
# SWID: includes the curly braces, e.g. {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_SWID=
